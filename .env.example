# Copy this file to .env and fill in real values. Never commit .env.

# Required for Stage 1 (Claude Agent SDK)
ANTHROPIC_API_KEY=sk-ant-...

# Required for Stage 2 (Gemini 3.1 Flash Live)
GOOGLE_API_KEY=...

# Optional — for the web site to call the API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — for Vercel production deploy
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Agent A backend (optional) ---
# Require callers of /analyze to send X-API-Key: <value>. Unset = open.
BROCK_API_KEY=
# /analyze rate limit (requests / window seconds) per client IP.
BROCK_RATE_LIMIT=10
BROCK_RATE_WINDOW_SECONDS=300
# Upload size cap for POST /analyze in bytes (default 50 MB).
BROCK_MAX_UPLOAD_BYTES=52428800
# Retries when the Agent SDK call fails with a transient error.
BROCK_RETRY_ATTEMPTS=2
# Comma-separated CORS origins. Use "*" for any origin (credentials off).
BROCK_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Where the citation audit JSONL goes. Defaults to logs/citations.jsonl.
CITATION_LOG_PATH=
