# Copy this file to .env and fill in real values. Never commit .env.

# Required for Stage 1 (Claude Agent SDK)
ANTHROPIC_API_KEY=sk-ant-...

# Required for Stage 2 (Gemini 3.1 Flash Live)
GOOGLE_API_KEY=...

# Optional — for the web site to call the API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — for Vercel production deploy
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
